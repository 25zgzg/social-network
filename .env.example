# Copy to .env and fill in real values before running.
# DJANGO_SECRET_KEY is required — the app refuses to start without it.
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
REDIS_URL=redis://127.0.0.1:6379
# Google OAuth: https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:8000/accounts/google/login/callback/
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Sentry: init is skipped entirely when SENTRY_DSN is empty
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.1
